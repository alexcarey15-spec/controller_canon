<launch>
  <!--
    ourbeloved_cannon.xml
    Runs on the CANNON computer.

      joint_state_node - owns the xarm connection. Publishes /joint_state,
                         executes /joint_command and /home_trigger.
      pose_node        - FK from /joint_state, publishes /pose.
      joy_input_node   - decodes /joy into /fire, /mode, /home_trigger,
                         /cmd_joint_vel, /cmd_cart_vel.
      cannon_node      - the brain. Reads /joint_state and the cmd_* topics,
                         publishes /joint_command.
  -->

  <node pkg="ourbeloved" exec="joint_state_node" name="joint_state_node" output="screen" />

  <node pkg="ourbeloved" exec="pose_node" name="pose_node" output="screen" />

  <node pkg="ourbeloved" exec="joy_input_node" name="joy_input_node" output="screen" />

  <node pkg="ourbeloved" exec="cannon_node" name="cannon_node" output="screen" />

</launch>
